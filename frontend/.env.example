# LoomLearn Frontend Environment Configuration

# Backend API Base URL (must end with /api)
# Local development default:
VITE_API_URL=http://localhost:8080/api

# Production Render backend example:
# VITE_API_URL=https://loomlearn-backend.onrender.com/api

# API Request timeout in milliseconds (defaults to 15000 = 15s)
VITE_API_TIMEOUT=15000

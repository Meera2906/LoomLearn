# LoomLearn Backend Environment Variables Example

# Server Port (Render will provide $PORT automatically)
PORT=8080

# Database Configuration (Option 1: Complete JDBC URL)
# For MySQL (Local):
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/loomlearn?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# For NeonDB (PostgreSQL):
# SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-endpoint>.us-west-2.aws.neon.tech/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=neondb_owner
# SPRING_DATASOURCE_PASSWORD=<your_neon_password>

# Database Configuration (Option 2: Individual variables)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=loomlearn
DB_USER=root
DB_PASSWORD=root

# JPA / Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Allowed CORS Origins (comma-separated, supports wildcard subdomain)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:*,https://*.vercel.app,https://*.onrender.com
